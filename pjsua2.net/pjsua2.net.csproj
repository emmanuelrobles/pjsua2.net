<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>pjsua2</AssemblyName>
        <RootNamespace>pjsua2</RootNamespace>

        <PackageId>PJSua2</PackageId>
        <Version>2.17.0</Version>
        <Authors>pjsua2.net</Authors>
        <Description>PJSUA2 .NET bindings generated by SWIG, bundling the native libpjsua2 library.</Description>
        <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>

        <!-- SWIG-generated code uses unsafe pointer access and pre-nullable idioms. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="runtimes/**" Pack="true" PackagePath="runtimes/" />
    </ItemGroup>

</Project>
